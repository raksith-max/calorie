# Required: get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-key-here

# Optional: vision model to use
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: free key from https://fdc.nal.usda.gov/api-key-signup (DEMO_KEY works but is rate limited)
USDA_API_KEY=DEMO_KEY

PORT=3001

# Required when hosted online: the password your phone asks for once
APP_PASSWORD=choose-a-long-password

# Optional: where the SQLite file lives (point at a persistent disk when hosted)
# DB_PATH=/var/data/data.db
